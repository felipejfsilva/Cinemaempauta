# CineCrítica BR — Configuração de API
# Copie este arquivo para .env e preencha os valores

# ===== INSTAGRAM GRAPH API =====
# Para obter:
#   1. Acesse developers.facebook.com → Criar app "Business"
#   2. Adicione o produto "Instagram Graph API"
#   3. Conecte sua conta Instagram Business/Creator
#   4. No Graph API Explorer, gere um User Token com permissões:
#      - instagram_basic
#      - instagram_content_publish
#      - pages_show_list
#      - pages_read_engagement
#   5. Converta para token de longa duração (60 dias):
#      GET /oauth/access_token?grant_type=fb_exchange_token&client_id={app-id}&client_secret={app-secret}&fb_exchange_token={short-token}

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ===== HOSPEDAGEM DE IMAGENS =====
# A Graph API exige URL pública para as imagens.
# Use UMA das opções abaixo:

# Opção 1: imgbb.com (grátis, recomendado)
#   Acesse api.imgbb.com → crie conta → copie API key
IMGBB_API_KEY=

# Opção 2: URL pública direta (se hospedar em servidor próprio)
# PUBLIC_URL=https://seu-servidor.com/cinecriticabr/slides

# Opção 3: GitHub raw (se os slides estiverem commitados)
# GITHUB_RAW_BASE=https://raw.githubusercontent.com/felipejfsilva/Cinemaempauta/main/conteudo/posts/01-super-xuxa
